# Database Configuration
# Get from: Local Postgres instance or docker-compose setup. E.g., postgres://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/tubernker?schema=public"
POSTGRES_PASSWORD="your_postgres_password"

# Redis Configuration
# Get from: Local Redis instance or docker-compose setup. E.g., redis://<host>:<port>
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
# Get from: Run `openssl rand -basehex 32` or similar random generator
NEXTAUTH_SECRET="super-secret-nextauth-key-value-at-least-32-chars"

# Google OAuth Keys
# Get from: Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-google-client-secret"

# Stripe Keys
# Get from: Stripe Dashboard -> Developers -> API keys (Standard Keys)
STRIPE_SECRET_KEY="sk_test_stripe_secret_key"
# Get from: Stripe Dashboard -> Developers -> Webhooks (Stripe CLI listening endpoint key)
STRIPE_WEBHOOK_SECRET="whsec_stripe_webhook_secret"

# YouTube Data API Key
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> API Keys
YOUTUBE_API_KEY="AIzaSyYoutubeApiKeyHere"

# Gemini AI API Key & Model
# Get from: Google AI Studio (https://aistudio.google.com/) API key section
GEMINI_API_KEY="AIzaSyGeminiApiKeyHere"
# Options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL="gemini-1.5-pro"

# Resend API Key for Emails
# Get from: Resend Dashboard (https://resend.com) -> API Keys
RESEND_API_KEY="re_ResendApiKeyHere"

# Sentry DSN
# Get from: Sentry Project Settings -> Client Keys (DSN)
SENTRY_DSN="https://sentry-dsn-key@o1111111.ingest.us.sentry.io/1111111"

# PostHog Key
# Get from: PostHog Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY="phc_PostHogApiKeyHere"

# OpenTelemetry Exporter Endpoint (e.g. Highlight, Axiom, Jeager)
# Get from: OpenTelemetry backend provider credentials page
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
